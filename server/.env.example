# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/hashbrowns
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hashbrowns
MONGODB_URI=mongodb://127.0.0.1:27017/hashbrowns

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API.
# Include your Vite dev URL and your deployed frontend's URL.
CLIENT_ORIGIN=http://localhost:5173

# --- Admin authentication (required to view/manage applications) ---

# Set NODE_ENV=production when deploying — enables strict env checks and
# secure (HTTPS-only) cookies.
NODE_ENV=development

# Long random secret used to sign admin session tokens.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional. Defaults to 8h. Examples: "8h", "30m", "1d".
JWT_EXPIRES_IN=8h

# Admin login username.
ADMIN_USERNAME=admin

# Bcrypt hash of the admin password — never put a plaintext password here.
# Generate one with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
